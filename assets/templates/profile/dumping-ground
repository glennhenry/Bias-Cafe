    function getCurrentBiasList() {
      const l = []
      $(".bias-list").children().each(function () {
        l.push($(this).attr("data-member-name"))
      })
      return l
    }

    function initializeBiasCheckbox() {
      const biasList = getCurrentBiasList()
      $(".checkbox-list").children().each(function () {
        const checkbox = $(this).children(`input[type="checkbox"]`)
        if (biasList.includes(checkbox.attr("id"))) {
          checkbox.prop("checked", true)
        } else {
          checkbox.prop("checked", false)
        }
      })
    }

    function getCheckedBias() {
      const biasList = []
      $(".checkbox-list").children().each(function () {
        const member = $(this).children(`input[type="checkbox"]:checked`).attr("id")
        if (member) biasList.push(member)
      })
      return biasList
    }

    function updateBiasList(newBiases) {
      $(".bias-list").empty()
      for (const bias of newBiases.sort((a, b) => a.localeCompare(b))) {
        $(".bias-list").append(
          $("<div></div>").addClass("bias-item").attr("data-member-name", bias).append($("<p></p>").text(bias))
        )
      }
    }

        $(document).ready(function () {
      $("#edit-bias-btn").click(function (event) {
        event.stopPropagation();
        initializeBiasCheckbox()
        $(".bias-checkbox-selector").removeClass("hidden");
      });

      $(".bias-checkbox-selector").click(function (event) {
        event.stopPropagation();
      });

      $(document).click(function (event) {
        const clickedInsideSelector =
          $(event.target).closest(".bias-checkbox-selector").length;

        const clickedEditButton =
          $(event.target).closest("#edit-bias-btn").length;

        if (!clickedInsideSelector && !clickedEditButton) {
          $(".bias-checkbox-selector").addClass("hidden");
        }
      });

      $(".checkbox-cancel").click(function () {
        $(".bias-checkbox-selector").addClass("hidden");
      });

      $(".checkbox-submit").click(function () {
        const biasList = getCheckedBias();
        $(".bias-checkbox-selector").addClass("hidden");
        updateBiasList(biasList)
      });
    })
