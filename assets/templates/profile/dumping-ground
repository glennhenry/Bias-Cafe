
    .bias-container {
      position: relative;
      display: flex;
      gap: 4px;
      padding: 8px;
      border-bottom: 1px solid #ccc;
      flex-direction: column;
    }

    .full-width {
      width: 100%;
    }

    .bias-list {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
    }

    .bias-item {
      width: fit-content;
      padding: 4px;
      background-color: #fbf4ff;
      border: 1px solid #ccc;
      border-radius: 4px;
    }

    .bias-list-action {
      text-align: end;
    }

    .bias-checkbox-selector {
      width: 150px;
      position: absolute;
      top: -1;
      right: 0;
      transform: translateX(100%);
      background-color: #fff;
      border: 1px solid #ccc;
      z-index: 100;
    }

    .checkbox-title {
      padding: 4px;
      font-size: 16px;
      background-color: #f2f2f2;
    }

    .checkbox-item {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 4px;
      border-top: 1px solid #ccc;
    }

    .checkbox-footer {
      padding: 4px;
      border-top: 1px solid #ccc;
      text-align: end;
    }

    .badge-list {
      max-height: 250px;
      overflow-y: auto;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 4px;
      padding: 8px;
      border-bottom: 1px solid #ccc;
    }

    .badge-item {
      width: 20px;
      height: 20px;
      background-color: #ccc;
    }

